# ============================================================================
# TradePilot – Intelligent Options Trading Command Center
# Environment Configuration (.env.example)
# ============================================================================

# --- Supabase Configuration (Frontend Safe) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# --- Market Data Configuration ---
# Supported values: SIMULATED_DEMO, POLYGON, TRADIER, CBOE_DELAYED
VITE_MARKET_DATA_MODE=SIMULATED_DEMO
VITE_DEFAULT_DISPLAY_TIMEZONE=America/Los_Angeles
VITE_MARKET_TIMEZONE=America/New_York

# --- Backend-Only Secrets (NEVER prefix with VITE_ or expose to browser) ---
# Used by Supabase Edge Functions / Netlify Functions only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
TRADINGVIEW_WEBHOOK_SECRET=your-hmac-webhook-secret
ROBINHOOD_MCP_SERVER_URL=http://127.0.0.1:8787/mcp
ROBINHOOD_MCP_AUTH_TOKEN=your-mcp-server-bearer-token
MARKET_DATA_API_KEY=your-market-data-provider-api-key
